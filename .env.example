# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/restaurant_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# JWT Configuration (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits-abcdefghijklmnop

# Server Configuration
SERVER_PORT=8080

# Restaurant Configuration
RESTAURANT_NAME=Smart Restaurant
RESTAURANT_LOGO=/images/logo.png
RESTAURANT_ADDRESS=123 Restaurant Street, City
RESTAURANT_PHONE=+91-9876543210
RESTAURANT_EMAIL=info@restaurant.com
RESTAURANT_GST=
RESTAURANT_TAX_RATE=5.0

# QR Code Configuration
QR_BASE_URL=http://192.168.56.1:8080
QR_SIZE=300
QR_FORMAT=PNG

# Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Admin Default Credentials (Change after first login!)
ADMIN_EMAIL=admin@restaurant.com
ADMIN_PASSWORD=admin123