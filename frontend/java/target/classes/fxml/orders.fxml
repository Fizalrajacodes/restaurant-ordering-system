<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.admin.controller.OrdersController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <!-- Filter Bar -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="filter-bar">
            <children>
                <Label styleClass="filter-label" text="Status:" />
                <ComboBox fx:id="orderStatusFilter" prefWidth="180.0" styleClass="filter-combo">
                </ComboBox>
                <TextField fx:id="orderSearchField" prefWidth="300.0" promptText="Search by order #, customer, table..." styleClass="filter-field" />
                <Button fx:id="filterBtn" onAction="#handleOrderFilter" styleClass="filter-button" text="Filter">
                    <graphic>
                        <Label styleClass="button-icon" text="🔍" />
                    </graphic>
                </Button>
                <Button fx:id="exportBtn" styleClass="filter-button secondary" text="Export">
                    <graphic>
                        <Label styleClass="button-icon" text="📥" />
                    </graphic>
                </Button>
            </children>
        </HBox>
        
        <!-- Orders Table -->
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="ordersTable" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colOrderNumber" prefWidth="150.0" text="Order #" />
                        <TableColumn fx:id="colTableNumber" prefWidth="100.0" text="Table" />
                        <TableColumn fx:id="colCustomerName" prefWidth="180.0" text="Customer" />
                        <TableColumn fx:id="colCustomerMobile" prefWidth="150.0" text="Mobile" />
                        <TableColumn fx:id="colItemsCount" prefWidth="80.0" text="Items" />
                        <TableColumn fx:id="colTotalAmount" prefWidth="120.0" text="Amount" />
                        <TableColumn fx:id="colOrderStatus" prefWidth="130.0" text="Order Status" />
                        <TableColumn fx:id="colPaymentStatus" prefWidth="130.0" text="Payment" />
                        <TableColumn fx:id="colOrderTime" prefWidth="180.0" text="Order Time" />
                        <TableColumn fx:id="colActions" prefWidth="120.0" text="Actions" />
                    </columns>
                </TableView>
            </children>
        </VBox>
        
        <!-- Pagination -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="pagination-bar">
            <children>
                <Label fx:id="paginationInfo" styleClass="pagination-info" text="Showing 1-10 of 50 orders" />
                <Button fx:id="prevPageBtn" disable="true" onAction="#handlePrevPage" styleClass="pagination-button" text="Previous" />
                <Button fx:id="nextPageBtn" onAction="#handleNextPage" styleClass="pagination-button" text="Next" />
            </children>
        </HBox>
    </children>
</VBox>