<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.admin.controller.MenuController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="toolbar">
            <children>
                <Label styleClass="toolbar-title" text="Menu Items" />
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <ComboBox fx:id="categoryFilter" prefWidth="200.0" styleClass="filter-combo" />
                        <TextField fx:id="menuSearchField" prefWidth="300.0" promptText="Search menu items..." styleClass="filter-field" />
                        <Button fx:id="addMenuItemBtn" onAction="#handleAddMenuItem" styleClass="toolbar-button primary" text="Add Item">
                            <graphic>
                                <Label styleClass="button-icon" text="➕" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>
        
        <!-- Menu Items Table -->
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="menuItemsTable" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colItemName" prefWidth="200.0" text="Name" />
                        <TableColumn fx:id="colItemCategory" prefWidth="150.0" text="Category" />
                        <TableColumn fx:id="colItemPrice" prefWidth="100.0" text="Price" />
                        <TableColumn fx:id="colItemType" prefWidth="100.0" text="Type" />
                        <TableColumn fx:id="colItemPrepTime" prefWidth="100.0" text="Prep Time" />
                        <TableColumn fx:id="colItemAvailability" prefWidth="120.0" text="Availability" />
                        <TableColumn fx:id="colItemFeatured" prefWidth="80.0" text="Featured" />
                        <TableColumn fx:id="colItemActions" prefWidth="120.0" text="Actions" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>