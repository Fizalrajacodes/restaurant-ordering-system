<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.admin.controller.ReportsController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <!-- Filter Bar -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="filter-bar">
            <children>
                <Label styleClass="filter-label" text="From:" />
                <DatePicker fx:id="reportStartDate" styleClass="filter-date-picker" />
                <Label styleClass="filter-label" text="To:" />
                <DatePicker fx:id="reportEndDate" styleClass="filter-date-picker" />
                <Button fx:id="generateReportBtn" onAction="#handleGenerateReport" styleClass="filter-button" text="Generate Report">
                    <graphic>
                        <Label styleClass="button-icon" text="📊" />
                    </graphic>
                </Button>
                <Button fx:id="exportReportBtn" styleClass="filter-button secondary" text="Export CSV">
                    <graphic>
                        <Label styleClass="button-icon" text="📥" />
                    </graphic>
                </Button>
            </children>
        </HBox>
        
        <!-- Report Summary Cards -->
        <HBox spacing="20.0" styleClass="report-summary-cards">
            <children>
                <VBox fx:id="totalRevenueCard" styleClass="report-card" HBox.hgrow="ALWAYS" />
                <VBox fx:id="totalOrdersCard" styleClass="report-card" HBox.hgrow="ALWAYS" />
                <VBox fx:id="completedOrdersCard" styleClass="report-card" HBox.hgrow="ALWAYS" />
                <VBox fx:id="avgOrderValueCard" styleClass="report-card" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
        
        <!-- Daily Revenue Table -->
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
            <children>
                <Label styleClass="section-title" text="Daily Revenue" />
                <TableView fx:id="dailyRevenueTable" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colReportDate" prefWidth="150.0" text="Date" />
                        <TableColumn fx:id="colReportRevenue" prefWidth="150.0" text="Revenue" />
                        <TableColumn fx:id="colReportOrders" prefWidth="120.0" text="Orders" />
                        <TableColumn fx:id="colReportAvgOrder" prefWidth="150.0" text="Avg Order Value" />
                    </columns>
                </TableView>
            </children>
        </VBox>
        
        <!-- Category Revenue Table -->
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
            <children>
                <Label styleClass="section-title" text="Revenue by Category" />
                <TableView fx:id="categoryRevenueTable" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colCatRevenueName" prefWidth="200.0" text="Category" />
                        <TableColumn fx:id="colCatRevenueAmount" prefWidth="150.0" text="Revenue" />
                        <TableColumn fx:id="colCatRevenueOrders" prefWidth="120.0" text="Orders" />
                        <TableColumn fx:id="colCatRevenuePercent" prefWidth="120.0" text="\% of Total" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>