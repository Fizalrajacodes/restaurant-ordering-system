<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.admin.controller.CategoriesController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="toolbar">
            <children>
                <Label styleClass="toolbar-title" text="Categories" />
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <TextField fx:id="categorySearchField" prefWidth="300.0" promptText="Search categories..." styleClass="filter-field" />
                        <Button fx:id="addCategoryBtn" onAction="#handleAddCategory" styleClass="toolbar-button primary" text="Add Category">
                            <graphic>
                                <Label styleClass="button-icon" text="➕" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>
        
        <!-- Categories Table -->
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="categoriesTable" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colCatName" prefWidth="200.0" text="Name" />
                        <TableColumn fx:id="colCatDescription" prefWidth="300.0" text="Description" />
                        <TableColumn fx:id="colCatDisplayOrder" prefWidth="100.0" text="Display Order" />
                        <TableColumn fx:id="colCatItemsCount" prefWidth="100.0" text="Items Count" />
                        <TableColumn fx:id="colCatStatus" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="colCatActions" prefWidth="120.0" text="Actions" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>