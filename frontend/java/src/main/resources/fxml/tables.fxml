<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.admin.controller.TablesController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="toolbar">
            <children>
                <Label styleClass="toolbar-title" text="Table Management" />
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="addTableBtn" onAction="#handleAddTable" styleClass="toolbar-button primary" text="Add Table">
                            <graphic>
                                <Label styleClass="button-icon" text="➕" />
                            </graphic>
                        </Button>
                        <Button fx:id="generateAllQrBtn" onAction="#handleGenerateAllQR" styleClass="toolbar-button" text="Generate All QR">
                            <graphic>
                                <Label styleClass="button-icon" text="📱" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>
        
        <!-- Tables Grid -->
        <ScrollPane fitToWidth="true" styleClass="tables-scroll" VBox.vgrow="ALWAYS">
            <content>
                <javafx.scene.layout.FlowPane fx:id="tablesFlowPane" hgap="20.0" vgap="20.0" prefWrapLength="1100">
                    <padding>
                        <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </javafx.scene.layout.FlowPane>
            </content>
        </ScrollPane>
    </children>
</VBox>