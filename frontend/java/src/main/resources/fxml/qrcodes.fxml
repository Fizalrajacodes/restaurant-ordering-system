<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="tab-content" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.admin.controller.QRCodesController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>
    <children>
        <!-- Toolbar -->
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="toolbar">
            <children>
                <Label styleClass="toolbar-title" text="QR Code Management" />
                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="generateAllQrBtn" onAction="#handleGenerateAllQR" styleClass="toolbar-button primary" text="Regenerate All">
                            <graphic>
                                <Label styleClass="button-icon" text="🔄" />
                            </graphic>
                        </Button>
                        <Button fx:id="printAllQrBtn" onAction="#handlePrintAllQR" styleClass="toolbar-button" text="Print All">
                            <graphic>
                                <Label styleClass="button-icon" text="🖨️" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>
        
        <!-- QR Codes Table -->
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="qrCodesTable" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colQrTableNumber" prefWidth="120.0" text="Table" />
                        <TableColumn fx:id="colQrTableName" prefWidth="150.0" text="Table Name" />
                        <TableColumn fx:id="colQrToken" prefWidth="180.0" text="Token" />
                        <TableColumn fx:id="colQrUrl" prefWidth="300.0" text="QR URL" />
                        <TableColumn fx:id="colQrScans" prefWidth="80.0" text="Scans" />
                        <TableColumn fx:id="colQrLastScan" prefWidth="150.0" text="Last Scan" />
                        <TableColumn fx:id="colQrActions" prefWidth="150.0" text="Actions" />
                    </columns>
                </TableView>
            </children>
        </VBox>
        
        <!-- QR Preview -->
        <VBox fx:id="qrPreviewPane" visible="false" styleClass="qr-preview-pane" VBox.vgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="qr-preview-header">
                    <children>
                        <Label styleClass="qr-preview-title" text="QR Code Preview" />
                        <Button fx:id="closePreviewBtn" onAction="#handleClosePreview" styleClass="toolbar-button" text="Close" />
                    </children>
                </HBox>
                <VBox alignment="CENTER" spacing="20.0" styleClass="qr-preview-content" VBox.vgrow="ALWAYS">
                    <children>
                        <Label fx:id="previewTableLabel" styleClass="preview-table-label" text="Table 01" />
                        <javafx.scene.image.ImageView fx:id="previewQrImage" fitWidth="300" fitHeight="300" preserveRatio="true" />
                        <Label fx:id="previewUrlLabel" styleClass="preview-url-label" wrapText="true" />
                        <HBox spacing="15.0">
                            <Button fx:id="downloadQrBtn" styleClass="toolbar-button primary" text="Download">
                                <graphic>
                                    <Label styleClass="button-icon" text="⬇️" />
                                </graphic>
                            </Button>
                            <Button fx:id="printQrBtn" styleClass="toolbar-button" text="Print">
                                <graphic>
                                    <Label styleClass="button-icon" text="🖨️" />
                                </graphic>
                            </Button>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>